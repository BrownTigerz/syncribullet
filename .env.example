# Copy this file to .env and fill in real values. Never commit .env.

# Letters and numbers only. Generate a fresh one and save it permanently:
# if this key changes, saved pairs and install links stop working.
PRIVATE_ENCRYPTION_KEY=ReplaceWithYourOwnRandomKey123

# Host port the app is reachable on (container port stays 3000).
HOST_PORT=8181

# How often the server reconciler runs, in minutes.
RECONCILE_INTERVAL_MINUTES=30

# Watch Together solo/together switch (TK's pair). Edit this one
# line and restart the container (docker compose up -d) to switch:
#   WATCH_TOGETHER=off   solo — TK's watches stop copying to Ange
#   WATCH_TOGETHER=on    together — mirroring resumes from a fresh
#                        starting point captured at the restart
# Leaving the line out entirely means no override: the Watch
# Together setting saved on the pair decides, as before.
# WATCH_TOGETHER=on
