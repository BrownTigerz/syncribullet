# Copy this file to .env and fill in real values. Never commit .env.

# Letters and numbers only. Generate a fresh one and save it permanently:
# if this key changes, saved pairs and install links stop working.
PRIVATE_ENCRYPTION_KEY=ReplaceWithYourOwnRandomKey123

# Host port the app is reachable on (container port stays 3000).
HOST_PORT=8181

# How often the server reconciler runs, in minutes.
RECONCILE_INTERVAL_MINUTES=30

# Watch Together solo/together switch (TK's pair). Edit this one
# line and restart the container (docker compose up -d) to switch:
#   WATCH_TOGETHER=off   solo — TK's watches stop copying to Ange
#   WATCH_TOGETHER=on    together — mirroring resumes from a fresh
#                        starting point captured at the restart
# Leaving the line out entirely means no override: the Watch
# Together setting saved on the pair decides, as before.
# WATCH_TOGETHER=on

# Marking modes for the live (stream-pick) writes. Restart the
# container after changing. Leaving a line out (or any other value)
# means the default: all.
#   LIVE_MARK=all      movies and episodes mark on your own Simkl
#                      the moment a stream is picked (default)
#   LIVE_MARK=movies   movies mark at pick; episodes only reach your
#                      Simkl via the reconciler, once Stremio flags
#                      them watched
#   LIVE_MARK=off      no live writes at all — your Simkl is kept in
#                      sync by the reconciler only
# LIVE_MARK=all
#   MIRROR_LIVE_MARK   same three values, for the instant Watch
#                      Together mirror only; the reconciler's mirror
#                      pass is never affected
# MIRROR_LIVE_MARK=all

# Public origin the server reports for itself. Leave unset for the
# usual http://localhost:<HOST_PORT> — set it only for the Tailscale
# HTTPS setup for Ange's addon (see SETUP.md "Ange's Addon Over
# Tailscale (HTTPS)"):
# APP_ORIGIN=https://your-pc.your-tailnet.ts.net
